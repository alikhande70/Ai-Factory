{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/secret-reference.schema.json",
  "title": "AI Factory Secret Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "secret_id",
    "provider",
    "mission_id",
    "required_capability",
    "purpose",
    "version"
  ],
  "properties": {
    "secret_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "required_capability": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "null"], "minLength": 1}
  }
}
