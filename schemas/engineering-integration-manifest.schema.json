{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/engineering-integration-manifest.schema.json",
  "title": "Engineering Integration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "package_order", "artifacts", "changed_paths", "verification_ids"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "package_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_name", "owner_package_id"],
        "properties": {
          "artifact_name": {"type": "string", "minLength": 1},
          "owner_package_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verification_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
