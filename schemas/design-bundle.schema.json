{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/design-bundle.schema.json",
  "title": "AI Factory Design Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "product_summary", "non_goals", "requirements", "acceptance_criteria", "architecture_decisions", "ux_flows", "assumptions", "risks"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "product_summary": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "statement", "priority", "source"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "priority": {"enum": ["MUST", "SHOULD", "COULD", "WONT"]},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "requirement_id", "statement", "verification_method"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "requirement_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "verification_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "architecture_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "title", "decision", "rationale", "requirement_ids"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "ux_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "title", "actor", "steps", "requirement_ids"],
        "properties": {
          "flow_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requirement_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
