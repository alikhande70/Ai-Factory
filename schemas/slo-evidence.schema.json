{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/slo-evidence.schema.json",
  "title": "AI Factory SLO Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective_id","operation","environment","sample_count","duration_seconds","p95_latency_ms","error_rate","throughput_per_second","latency_pass","error_rate_pass","throughput_pass","sufficient_samples","qualified","claim_scope"],
  "properties": {
    "objective_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "environment": {"enum": ["LOCAL","CI","STAGING","PRODUCTION"]},
    "sample_count": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "p95_latency_ms": {"type": "number", "minimum": 0},
    "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "throughput_per_second": {"type": "number", "minimum": 0},
    "latency_pass": {"type": "boolean"},
    "error_rate_pass": {"type": "boolean"},
    "throughput_pass": {"type": "boolean"},
    "sufficient_samples": {"type": "boolean"},
    "qualified": {"type": "boolean"},
    "claim_scope": {"enum": ["NON_PRODUCTION_QUALIFICATION_ONLY","PRODUCTION_SLO_EVIDENCE"]}
  }
}
