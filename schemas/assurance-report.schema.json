{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/assurance-report.schema.json",
  "title": "AssuranceReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "mission_id", "reviewer_agent", "subject_artifact_ref", "findings", "verification_refs"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "reviewer_agent": {"enum": ["A09-SECURITY", "A10-QA", "A12-RED-TEAM"]},
    "subject_artifact_ref": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "category", "severity", "subject_ref", "statement", "evidence_refs", "remediation", "blocking"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "subject_ref": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "remediation": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "verification_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
