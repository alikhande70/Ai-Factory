{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/real-estate-consumer-listing.schema.json",
  "title": "Real Estate Consumer Listing Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_id", "title", "city", "locality", "price_minor", "area_sqm", "state", "last_verified_at", "freshness_code", "disclosure_score", "source_count", "rights_bases", "trust_code", "verification_badge", "message_codes"],
  "properties": {
    "canonical_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "city": {"type": "string"},
    "locality": {"type": "string"},
    "price_minor": {"type": "integer", "minimum": 0},
    "area_sqm": {"type": "number", "exclusiveMinimum": 0},
    "bedrooms": {"type": ["integer", "null"], "minimum": 0},
    "state": {"type": "string", "minLength": 1},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "freshness_code": {"enum": ["FRESH", "STALE"]},
    "disclosure_score": {"type": "number", "minimum": 0, "maximum": 1},
    "source_count": {"type": "integer", "minimum": 1},
    "rights_bases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trust_code": {"enum": ["UNKNOWN", "EVIDENCE_AVAILABLE", "NEEDS_REVIEW"]},
    "verification_badge": {"type": "boolean"},
    "message_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
