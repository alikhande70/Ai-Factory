{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/real-estate-locale-context.schema.json",
  "title": "Real Estate Locale Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "language", "numbering_system", "direction", "timezone", "currency_code"],
  "properties": {
    "locale": {"enum": ["fa-IR", "en-US"]},
    "language": {"enum": ["fa", "en"]},
    "numbering_system": {"enum": ["arabext", "latn"]},
    "direction": {"enum": ["RTL", "LTR"]},
    "timezone": {"type": "string", "minLength": 1},
    "currency_code": {"enum": ["IRR", "EUR", "USD"]}
  }
}
