{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/engineering-evidence-manifest.schema.json",
  "title": "EngineeringEvidenceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "changed_paths", "produced_artifacts", "verification_results"],
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "produced_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verification_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_id", "method", "status", "evidence_ref"],
        "properties": {
          "verification_id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL"]},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
