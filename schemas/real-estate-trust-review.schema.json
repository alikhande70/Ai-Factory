{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/real-estate-trust-review.schema.json",
  "title": "Real Estate Trust Review Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "finding_id",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["OPEN", "IN_REVIEW", "RESOLVED", "DISMISSED"]},
    "assigned_reviewer": {"type": ["string", "null"], "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "resolution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["outcome", "reviewer_id", "evidence_refs", "note"],
      "properties": {
        "outcome": {
          "enum": ["CONFIRMED_ANOMALY", "FALSE_POSITIVE", "INSUFFICIENT_EVIDENCE"]
        },
        "reviewer_id": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
