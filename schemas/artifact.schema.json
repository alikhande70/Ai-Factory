{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aifactory.local/schemas/artifact.schema.json","title":"Artifact","type":"object","additionalProperties":false,
  "required":["artifact_id","mission_id","producer_agent","kind","uri","version","content_hash","provenance","trusted"],
  "properties":{"artifact_id":{"type":"string","pattern":"^ART-[A-Z0-9_-]+$"},"mission_id":{"type":"string"},"producer_agent":{"type":"string"},"kind":{"enum":["CODE","DOCUMENT","SCHEMA","TEST_RESULT","BUILD_RESULT","RESEARCH","DECISION","OTHER"]},"uri":{"type":"string","minLength":1},"version":{"type":"integer","minimum":1},"content_hash":{"type":"string","minLength":8},"provenance":{"type":"array","minItems":1,"items":{"type":"string"}},"trusted":{"type":"boolean"}}
}