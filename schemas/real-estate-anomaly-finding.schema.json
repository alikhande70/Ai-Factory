{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/real-estate-anomaly-finding.schema.json",
  "title": "Real Estate Anomaly Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "anomaly_type",
    "severity",
    "canonical_id",
    "source_version_ids",
    "detector_id",
    "evidence_refs",
    "evidence_fingerprint",
    "summary",
    "observed_value",
    "threshold"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "anomaly_type": {"type": "string", "minLength": 1},
    "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "canonical_id": {"type": "string", "minLength": 1},
    "source_version_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "detector_id": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary": {"type": "string", "minLength": 1},
    "observed_value": {"type": "number", "minimum": 0},
    "threshold": {"type": "number", "minimum": 0}
  }
}
